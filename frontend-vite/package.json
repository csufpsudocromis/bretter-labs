{
  "name": "bretter-labs-frontend",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint src --ext .js,.jsx --max-warnings=0",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"tests/**/*.{js,jsx}\" \"e2e/**/*.{js,jsx}\" \"playwright.rdp.config.js\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" \"tests/**/*.{js,jsx}\" \"e2e/**/*.{js,jsx}\" \"playwright.rdp.config.js\"",
    "generate:api-types": "openapi-typescript ../backend/openapi/openapi.json -o src/api/openapi-types.d.ts",
    "test": "vitest run",
    "test:e2e:rdp": "playwright test -c playwright.rdp.config.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.8.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
